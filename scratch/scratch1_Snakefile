LR_IND = ["ABOFRAM000703115255"]
LR_CALLER = ["cutesv", "pbsv", "sniffles"]

rule all:
    input:
        [expand("LR_vcf/aut_{sample}_{lr_caller}.vcf.gz", sample=LR_IND, lr_caller=LR_CALLER), 
        expand("metadata/filter_imprecise_qual_RD_{lr_caller}/pos_target_{sample}.txt", sample=LR_IND, lr_caller=LR_CALLER)]

rule raw_bgzip_tabix_vcf:
    input:
        "../data1/{sample}_{lr_caller}.vcf"
    log:
        "log/{sample}/raw_bgzip_{lr_caller}.log"
    output:
        temp("LR_vcf/{sample}_{lr_caller}.vcf.gz"),
        temp("LR_vcf/{sample}_{lr_caller}.vcf.gz.tbi")
    shell:
        "bgzip -c {input} > {output[0]} ; tabix -p vcf {output[0]} "

rule bcftools_filter_autosome_LR:
    input:
        bed="../basis/ars_pos.bed",
        vcf="LR_vcf/{sample}_{lr_caller}.vcf.gz",
        tbi="LR_vcf/{sample}_{lr_caller}.vcf.gz.tbi"
    log:
        "log/{sample}/filter_autosome_{lr_caller}.log"
    output:
        temp("LR_vcf/aut_{sample}_{lr_caller}.vcf.gz"),
        temp("LR_vcf/aut_{sample}_{lr_caller}.vcf.gz.tbi")
    shell:
        "bcftools view -R {input.bed} {input.vcf} -O z -o {output[0]};  tabix -p vcf {output[0]} "

rule bcftools_filter_SV_type:
    input:
        "LR_vcf/aut_{sample}_{lr_caller}.vcf.gz", 
        "LR_vcf/aut_{sample}_{lr_caller}.vcf.gz.tbi"
    output:
        "LR_vcf/filt_{sample}_{lr_caller}.vcf"
    log:
        "log/{sample}/filter_SVtype_{lr_caller}.log"
    params:
        filter=lambda w, input: f"--include 'SVTYPE=\"DEL\" | SVTYPE=\"INS\" | SVTYPE=\"DUP\" | SVTYPE=\"INV\"'",
        extra="",
    wrapper:
        "v3.13.8/bio/bcftools/filter"
    
#shell:
 #       "bcftools filter -i 'SVTYPE="DEL" | SVTYPE="INS" | SVTYPE="DUP" | SVTYPE="INV" ' {input[0]} > {output} "
    
rule bcftools_get_pos_len_imprecise_qual_RD_cutesv:
    input:
        "LR_vcf/filt_{sample}_cutesv.vcf"
    output:
        "metadata/filter_imprecise_qual_RD_cutesv/pos_initial_{sample}.txt",
        "metadata/filter_imprecise_qual_RD_cutesv/pos_target_{sample}.txt"
    log:
        "log/{sample}/filter_get_pos_imprecise_qual_RD_cutesv.log"
    shell:
        """
        bcftools query -f '%CHROM %POS %SVTYPE %SVLEN cutesv %IMPRECISE %QUAL [%GT %DR,%DV]\n' {input} > {output[0]} ; 
        sed "s/,/ /g" {output[0]} | awk '($7 >=20){{print $0}}' | awk '($6!=1){{print $0}}' | awk '($4 <=-50 || $4 >=50){{print $0}}' |  awk '($4 >=-10000 || $4 <=10000){{print $0}}' | awk '($9+$10 => 5){{print $1, $2}}' | tr ' ' '\t' > {output[1]} 
        """

