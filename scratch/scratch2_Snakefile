rule bgzip_tabix_vcf:
    input:
        "data1/{sample}_{lr_caller}.vcf"
    output:
        vcfs="lr_vcf/{sample}_{lr_caller}.vcf.gz",
        tbis="lr_vcf/{sample}_{lr_caller}.vcf.gz.tbi"
    shell:
        "bgzip -c {input} > {output.vcfs} ; tabix -p vcf {output.vcfs} "

rule filter_autosome_LRvcf:
    input:
        bed="basis/ars_pos.bed",
        vcf="lr_vcf/{sample}_{lr_caller}.vcf.gz",
        tbi="lr_vcf/{sample}_{lr_caller}.vcf.gz.tbi"
    output:
        vcfs="call/aut_{sample}_{lr_caller}.vcf.gz",
        tbis="call/aut_{sample}_{lr_caller}.vcf.gz.tbi"
    shell:
        "bcftools view -R {input.bed} {input.vcf} -O z -o {output.vcfs} ; tabix -p vcf {output.vcfs} "

rule filter_imprecise_LRvcf:
    input:
        "call/aut_{sample}_{lr_caller}.vcf.gz",
    output:
        "call/filter_{sample}_{lr_caller}.vcf.gz",
    params:
        filter="-e 'POS>INFO/END | IMPRECISE=1' ",
    wrapper:
        "v3.13.5/bio/bcftools/filter"

rule filter_BND_LRvcf:
    input:
        "call/filter_{sample}_{lr_caller}.vcf.gz",
    output:
        "call/filter1_{sample}_{lr_caller}.vcf.gz",
    params:
        filter="-i 'FILTER=\"PASS\" & SVTYPE!=\"BND\" & SVTYPE!=\"INVDUP\"' ",
    wrapper:
        "v3.13.5/bio/bcftools/filter"

rule reheader_sampleVCF:
    input:
        "call/filter1_{sample}_{lr_caller}.vcf.gz" 
    output:
        "call/filter2_{sample}_{lr_caller}.vcf.gz"
    shell:
        r"echo {wildcards.sample}_{wildcards.lr_caller} > temp/{wildcards.sample}_{wildcards.lr_caller}.txt; bcftools reheader --sample temp/{wildcards.sample}_{wildcards.lr_caller}.txt {input} -o {output} " 

rule rename_DUP_TANDEM:
    input:
        "call/filter2_{sample}_{lr_caller}.vcf.gz"
    output:
        "call/filtered_{sample}_{lr_caller}.vcf"
    shell:
        r"bgzip -dc {input} | sed -E 's/SVTYPE=DUP\:TANDEM/SVTYPE=DUP/' | sed -E 's/\<DUP\:TANDEM\>/DUP/' > {output} "

rule list_vcfs:
    input:
        vcfs=expand("call/filtered_{sample}_{lr_caller}.vcf", sample=SAMPLES, lr_caller=LR_CALLER)
    output:
        "temp/list_vcf.txt"
    shell:
        "echo {input} | tr ' ' '\n' > {output}"

rule survivor_stats:
    input:
        "call/filtered_{sample}_{lr_caller}.vcf"
    output:
        "stats/survivor_{sample}_{lr_caller}.txt"
    shell:
        "SURVIVOR stats {input} 50 -1 -1 {output}" 

rule fig1_distribution_SV: ##NEED TO WORK ON THIS
    input:
        vcfs=expand("stats/survivor_{sample}_{lr_caller}.txt", sample=SAMPLES, lr_caller=LR_CALLER)
    output:
        "stats/summary.txt"
    params:
        comm=r" -v sample={wildcards.sample} -v caller={wildcards.lr_caller} '{print $0, sample, caller}'"
    shell:
        "for file in {input}; do cat $file | awk '{params.comm}' >> {output}; done"

##################################################################################################################
#JASMINE MERGING##
rule LR_jasmine_file1:
    input:
        "call/filtered_{sample}_{lr_caller}.vcf"
    output:
        "preproc_vcf_jasmine/samples_{sample}_{lr_caller}.txt"
    shell:
        "echo {input} > {output} "

rule LR_vcf_preprocess_jasmine:
    input:
        list_file="preproc_vcf_jasmine/samples_{sample}_{lr_caller}.txt",
        ref_gen="/work/project/G2BSeq/Sequences/RUN7/REF/ARS-UCD1.2_Btau5.0.1Y.fa"
    output:
        vcf="preproc_vcf_jasmine/filtered_{sample}_{lr_caller}_dupToIns.vcf"
    conda:
        "jasmine_env.yml"
    shell:
        """
        jasmine file_list={input.list_file} out_dir=preproc_vcf_jasmine  genome_file={input.ref_gen} --dup_to_ins --preprocess_only --normalize_type out_file={output.vcf} ;
        rm preproc_vcf_jasmine/samples_{wildcards.sample}_{wildcards.lr_caller}_dupToIns.txt ;
        rm preproc_vcf_jasmine/samples_{wildcards.sample}_{wildcards.lr_caller}.txt
        """

for tool in LR_CALLER:
    rule:
        name: f"LR_vcf_{tool}merge_jasmine"
        input:
            vcf=expand(f"preproc_vcf_jasmine/filtered_{{train_ind}}_{tool}_dupToIns.vcf", train_ind=TRAIN_IND),
            ref_gen="/work/project/G2BSeq/Sequences/RUN7/REF/ARS-UCD1.2_Btau5.0.1Y.fa"
        output:
            f"J_bench_folder/temp_merge_{tool}_dupToIns.vcf"
        conda:
            "jasmine_env.yml"
        resources:
            ntasks=1,
            cpus_per_task=3,
            mem_mb_per_cpu=12000,
            runtime=4440
        shell:
            f"""
            echo {{input.vcf}} | tr ' ' '\n' > test/{tool}_list.txt
            jasmine file_list=test/{tool}_list.txt out_file={{output}} genome_file={{input.ref_gen}} --ignore_strand --mutual_distance --allow_intrasample --output_genotypes --threads 3;
            """

    rule:
        name: f"LR_vcf_{tool}_postprocess_jasmine"
        input:
            vcf=f"J_bench_folder/temp_merge_{tool}_dupToIns.vcf",
            ref_gen="/work/project/G2BSeq/Sequences/RUN7/REF/ARS-UCD1.2_Btau5.0.1Y.fa"
        output:
            f"J_bench_folder/merge_{tool}_dupToIns.vcf"
        conda:
            "jasmine_env.yml"
        resources: 
            ntasks=1,
            cpus_per_task=1,
            mem_mb_per_cpu=35000,
            runtime=1440
        shell:
            f"""
            cp {{input.vcf}} J_bench_folder/merge_{tool}_dupToIns.vcf
            jasmine out_file={{output}} genome_file={{input.ref_gen}} --dup_to_ins --postprocess_only
            """

