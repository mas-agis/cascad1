####Additional where the based truth set is adjusted with removing SV that are also removed in the creation of the panel 
rule breed_split_truth_set_adjust:
    input:
        base=get_panel1,
        sv_removed="jasmine/sv_removed/sv_removed_{panel}.tsv.gz"
    output:
        base_del="truvari_graph/truth_set/DEL_{sample}_{panel}.vcf.gz",
        base_ins="truvari_graph/truth_set/INS_{sample}_{panel}.vcf.gz"
    conda:
        "envs/truvari.yml"
    params:
        tempdir=config['tmpdir'],
    log:
        stderr="logs/truvari/breed_split_truth_set/{sample}_{panel}.log"
    shell:
        r"""
        #DEL
        bcftools view -T \^{input.sv_removed} {input.base} | bcftools filter -i 'SVTYPE="DEL"' | bgzip -c > {output.base_del} 
        tabix -p vcf {output.base_del}
        #INS
        bcftools view -T \^{input.sv_removed} {input.base} | bcftools filter -i 'SVTYPE="INS"' | bgzip -c > {output.base_ins} 
        tabix -p vcf {output.base_ins}
        """

