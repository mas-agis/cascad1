import sys
import pandas as pd

# Modules
include: "rules/functions.smk"
include: "rules/vg_breed_pipe.smk"

samples = pd.read_table(config["samples3"],
                        dtype={"sample": str}).set_index("sample", drop=False)

PANEL_SV = ["HOL3n2", "dairy3n2", "dairy4n2", "all1n2"]
##EXPLANATION OF THE NAMING VCF-PANEL ABOVE
#HOL3n2 : Holstein breed only panel
#dairy3n2 : Holstein+Montbeliarde breeds panel
#dairy4n2 : Holstein+Montbeliarde+Normande breeds panel 
#all1n2 : Holstein+Montbeliarde+Normande+11 breeds panel
#n2 : indicates we retain only SV with minimum alternative counts of 4

workdir: config['workdir']
temp_dir: config['tmpdir']

# Target rules - step by step
rule all:
    input:
        [expand("vg_breed_call/wg_{sample}_{panel}.vcf.gz.tbi", sample=samples.index, panel=PANEL_SV)]
